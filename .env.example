# Variables de entorno para el backend PostgreSQL
# Usa DATABASE_URL para Neon o Supabase cuando tengas una DB remota.
# Ejemplo: DATABASE_URL=postgresql://user:password@host:5432/aerolinea
DATABASE_URL=
PG_CONNECTION_STRING=

DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aerolinea
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Opcional para Vite
BROWSER=chrome
